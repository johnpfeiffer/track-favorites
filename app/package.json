{
  "name": "track-favorites-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:convex": "tsc -p convex/tsconfig.json",
    "validate": "npm test && npm run typecheck:convex && npm run build",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.4.0",
    "convex": "^1.32.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "convex-test": "^0.0.55",
    "jsdom": "^30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.27.0": true
  }
}
